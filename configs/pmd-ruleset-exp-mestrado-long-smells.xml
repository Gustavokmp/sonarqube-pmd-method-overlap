<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="exp-mestrado-long-smells"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>
        Ruleset exclusivo do experimento exp-mestrado: contem somente as duas
        regras usadas para comparar SonarQube e PMD (Long Method e Long
        Parameter List), com os parametros fixados em PROTOCOLO.md.
    </description>

    <rule ref="category/java/design.xml/NcssCount">
        <properties>
            <property name="methodReportLevel" value="60" />
        </properties>
    </rule>

    <rule ref="category/java/design.xml/ExcessiveParameterList">
        <properties>
            <property name="minimum" value="10" />
        </properties>
    </rule>

</ruleset>
